#!/bin/sh
# NordVPN WireGuard Manager for Asuswrt-Merlin
# v0.1.5
# Runtime: Asuswrt-Merlin stock /bin/sh (BusyBox ash)
set -eu

PATH="/opt/bin:/opt/sbin:/usr/sbin:/usr/bin:/sbin:/bin:${PATH:-}"
export PATH

APP_NAME="nordvpn-wg"
VERSION="0.1.5"
NORD_API="https://api.nordvpn.com/v1"
DEFAULT_CONFIG="/opt/etc/nordvpn-wg.conf"
DEFAULT_TOKEN_FILE="/opt/etc/nordvpn-wg/token"
DEFAULT_STATE_DIR="/opt/var/lib/nordvpn-wg"

CONFIG_FILE="$DEFAULT_CONFIG"
TOKEN_FILE="$DEFAULT_TOKEN_FILE"
STATE_DIR="$DEFAULT_STATE_DIR"
OUTPUT_DIR="${PWD}"

WG_ADDRESS="10.5.0.2/32"
WG_DNS="192.168.50.1"
WG_ALLOWED_IPS="0.0.0.0/0,::/0"
WG_ENDPOINT_PORT="51820"
WG_KEEPALIVE="60"
WG_MTU=""
MERLIN_ENABLE="1"
MERLIN_ENFORCE="1"
MERLIN_FIREWALL="1"
MERLIN_NAT="1"
MERLIN_PSK=""
MERLIN_TP=""
MERLIN_TP_REGION=""
MERLIN_ENDPOINT_MODE="ip"
BACKUP_BEFORE_WRITE="1"
NVRAM_COMMIT="1"
AUTO_APPLY="1"

COUNTRY=""
CITY=""
SERVER=""
GROUP=""
DESCRIPTION=""
LIMIT="10"
DRY_RUN="0"
ASSUME_YES="0"
ACCESS_TOKEN="${NORDVPN_TOKEN:-}"

TMPDIR_RUN="/tmp/nordvpn-wg.$$"
mkdir -p "$TMPDIR_RUN"
cleanup() { rm -rf "$TMPDIR_RUN" 2>/dev/null || true; }
trap cleanup EXIT HUP INT TERM
tmpfile() { printf '%s/%s' "$TMPDIR_RUN" "$1"; }

usage() {
  cat <<EOF
$APP_NAME $VERSION

Router-native NordVPN WireGuard configuration manager for Asuswrt-Merlin.
Runs under the stock Merlin /bin/sh. Entware curl and jq are required.

Usage:
  $APP_NAME countries
  $APP_NAME servers [--country NAME|CODE] [--city NAME] [--limit N]
  $APP_NAME auth-test
  $APP_NAME merlin list
  $APP_NAME merlin show wgcN
  $APP_NAME merlin create wgcN [filters] [--dry-run]
  $APP_NAME merlin update wgcN [filters] [--dry-run]

Options:
  --country NAME|CODE
  --city NAME
  --server HOSTNAME
  --group NAME
  --limit N
  --config FILE
  --token TOKEN
  --token-file FILE
  --desc TEXT
  --dns IP
  --keepalive N
  --mtu N
  --endpoint ip|hostname
  --dry-run
  --yes, -y
  -h, --help
  -v, --version
EOF
}

log() { printf '[i] %s\n' "$*"; }
ok() { printf '[+] %s\n' "$*"; }
die() { printf '[x] %s\n' "$*" >&2; exit 1; }

have_cmd() {
  case "$1" in
    */*) [ -x "$1" ] ;;
    *)
      old_ifs=$IFS; IFS=:
      for d in $PATH; do
        [ -n "$d" ] || d=.
        if [ -x "$d/$1" ]; then IFS=$old_ifs; return 0; fi
      done
      IFS=$old_ifs; return 1
      ;;
  esac
}
need() { have_cmd "$1" || die "Required command not found: $1"; }

load_config() {
  [ -f "$DEFAULT_CONFIG" ] && . "$DEFAULT_CONFIG"
  [ "$CONFIG_FILE" = "$DEFAULT_CONFIG" ] || { [ -f "$CONFIG_FILE" ] && . "$CONFIG_FILE"; }
}

api_get() {
  need curl
  curl -g -fsSL --connect-timeout 10 --max-time 30 "$1"
}

sanitize_token() {
  # Nord access tokens contain no whitespace. Removing it also handles CRLF
  # and accidental spaces introduced while copying the token to the router.
  printf '%s' "$1" | tr -d '[:space:]'
}

read_token() {
  if [ -n "$ACCESS_TOKEN" ]; then
    token=$(sanitize_token "$ACCESS_TOKEN")
  else
    [ -r "$TOKEN_FILE" ] || die "No Nord access token. Create $TOKEN_FILE or use --token."
    token=$(sed -n '1p' "$TOKEN_FILE" | tr -d '[:space:]')
  fi
  [ -n "$token" ] || die "Nord access token is empty."
  [ "${#token}" -ge 20 ] || die "Nord access token looks too short; check $TOKEN_FILE."
  printf '%s' "$token"
}

credentials_request() {
  outfile=$1
  token=$(read_token)
  need curl
  # Do not use -f here: callers need the HTTP status for useful diagnostics.
  curl -g -sS --connect-timeout 10 --max-time 30 \
    -o "$outfile" -w '%{http_code}' \
    -u "token:${token}" \
    "${NORD_API}/users/services/credentials"
}

auth_test() {
  need jq
  f=$(tmpfile credentials.json)
  status=$(credentials_request "$f") || die "Unable to contact Nord service-credentials API."
  case "$status" in
    200)
      if jq -e '.nordlynx_private_key | select(type=="string" and length>20)' "$f" >/dev/null 2>&1; then
        ok "Nord access token accepted; NordLynx credentials are available."
      else
        die "Nord accepted the request but no NordLynx private key was returned."
      fi
      ;;
    401) die "Nord rejected the access token (HTTP 401). Generate/verify a NordVPN access token under Nord Account > NordVPN > Advanced settings." ;;
    *) die "Nord service-credentials API returned HTTP $status." ;;
  esac
}

fetch_private_key() {
  need jq
  f=$(tmpfile credentials.json)
  status=$(credentials_request "$f") || die "Unable to contact Nord service-credentials API."
  [ "$status" = "200" ] || {
    [ "$status" = "401" ] && die "Nord rejected the access token (HTTP 401). Run '$APP_NAME auth-test' after checking the token."
    die "Nord service-credentials API returned HTTP $status."
  }
  jq -er '.nordlynx_private_key | select(type=="string" and length>20)' "$f" || die "Nord API did not return a NordLynx private key."
}

normalize() { printf '%s' "$1" | tr '[:upper:] -' '[:lower:]__'; }

resolve_country_id() {
  req=$(normalize "$1")
  f=$(tmpfile countries.json)
  api_get "${NORD_API}/servers/countries" > "$f" || return 1
  jq -r '.[] | [.id, (.code // ""), (.name // "")] | @tsv' "$f" |
  while IFS="$(printf '\t')" read -r id code name; do
    [ "$(normalize "$code")" = "$req" ] || [ "$(normalize "$name")" = "$req" ] || continue
    printf '%s\n' "$id"
    break
  done
}

fetch_candidates_to_file() {
  out=$1
  need jq
  raw=$(tmpfile servers-raw.json)
  if [ -n "$SERVER" ]; then
    host="$SERVER"; case "$host" in *.nordvpn.com) ;; *) host="${host}.nordvpn.com" ;; esac
    api_get "${NORD_API}/servers?limit=10000" > "$raw" || die "Unable to download Nord server catalogue."
    jq -c --arg h "$(printf '%s' "$host" | tr '[:upper:]' '[:lower:]')" '[.[] | select(((.hostname // "")|ascii_downcase)==$h) | select(any(.technologies[]?; .identifier=="wireguard_udp"))]' "$raw" > "$out"
    return
  fi
  url="${NORD_API}/servers/recommendations?filters[servers.status]=online&filters[servers_technologies][identifier]=wireguard_udp&limit=100"
  if [ -n "$COUNTRY" ]; then
    cid=$(resolve_country_id "$COUNTRY") || die "Unknown NordVPN country: $COUNTRY"
    [ -n "$cid" ] || die "Unknown NordVPN country: $COUNTRY"
    url="${url}&filters[country_id]=${cid}"
  fi
  api_get "$url" > "$raw" || die "Unable to retrieve Nord server recommendations."
  jq -c --arg city "$CITY" --arg group "$GROUP" '[.[]
    | select(any(.technologies[]?; .identifier=="wireguard_udp"))
    | select(($city=="") or (((.locations[0].country.city.name // "")|ascii_downcase)==($city|ascii_downcase)))
    | select(($group=="") or any(.groups[]?; (((.identifier // "")|ascii_downcase)==($group|ascii_downcase)) or (((.title // "")|ascii_downcase)==($group|ascii_downcase))))]' "$raw" > "$out"
}

list_countries() {
  need jq
  api_get "${NORD_API}/servers/countries" | jq -r '.[] | [.code,.name] | @tsv' | sort -k2
}

print_servers() {
  f=$(tmpfile candidates.json)
  fetch_candidates_to_file "$f"
  printf '%-22s %-16s %-24s %5s  %s\n' HOSTNAME COUNTRY CITY LOAD IP
  jq -r --argjson limit "$LIMIT" '.[:$limit][] | [(.hostname // "-"),(.locations[0].country.name // "-"),(.locations[0].country.city.name // "-"),((.load // 0)|tostring),(.station // "-")] | @tsv' "$f" |
    awk -F '\t' '{printf "%-22s %-16s %-24s %4s%%  %s\n",$1,$2,$3,$4,$5}'
}

validate_client() { case "$1" in wgc1|wgc2|wgc3|wgc4|wgc5) ;; *) die "Merlin client must be wgc1 through wgc5." ;; esac; }
merlin_preflight() { need nvram; need wg; need service; [ -n "$(nvram get productid 2>/dev/null || true)" ] || die "This does not appear to be an Asuswrt-Merlin router."; }

merlin_list() {
  merlin_preflight
  printf '%-5s %-7s %-24s %-24s %s\n' SLOT ENABLED DESCRIPTION ENDPOINT PUBLIC_IP
  for i in 1 2 3 4 5; do
    c="wgc$i"; desc=$(nvram get "${c}_desc"); enabled=$(nvram get "${c}_enable"); ep=$(nvram get "${c}_ep_addr"); rip=$(nvram get "${c}_rip")
    [ -n "${desc}${ep}${enabled}" ] || continue
    printf '%-5s %-7s %-24.24s %-24.24s %s\n' "$c" "${enabled:-0}" "${desc:--}" "${ep:--}" "${rip:--}"
  done
}

merlin_show() { validate_client "$1"; merlin_preflight; nvram show 2>/dev/null | grep "^${1}_" | sort; }

select_profile() {
  f=$(tmpfile candidates.json)
  fetch_candidates_to_file "$f"
  count=$(jq 'length' "$f")
  [ "$count" -gt 0 ] || die "No matching online NordLynx servers found."
  chosen=$(tmpfile chosen.json)
  jq -c '.[0]' "$f" > "$chosen"
  private_key=$(fetch_private_key)
  peer_key=$(jq -er 'first(.technologies[]? | select(.identifier=="wireguard_udp") | .metadata[]? | select((.name // "")=="public_key") | .value)' "$chosen") || die "Selected server has no WireGuard public key."
  endpoint_ip=$(jq -er '.station' "$chosen") || die "Selected server has no endpoint IP."
  hostname=$(jq -er '.hostname' "$chosen") || die "Selected server has no hostname."
  country_name=$(jq -r '.locations[0].country.name // "Unknown"' "$chosen")
  city_name=$(jq -r '.locations[0].country.city.name // "Unknown"' "$chosen")
  case "$MERLIN_ENDPOINT_MODE" in hostname) endpoint="$hostname" ;; *) endpoint="$endpoint_ip" ;; esac
}

profile_desc() { if [ -n "$DESCRIPTION" ]; then printf '%s' "$DESCRIPTION"; elif [ "$city_name" != "Unknown" ]; then printf 'Nord %s' "$city_name"; else printf 'Nord %s' "$country_name"; fi; }
backup_client() { [ "$BACKUP_BEFORE_WRITE" = "1" ] || return 0; mkdir -p "$STATE_DIR/backups"; file="$STATE_DIR/backups/$1-$(date +%Y%m%d-%H%M%S).nvram"; nvram show 2>/dev/null | grep "^${1}_" | sort > "$file" || true; chmod 600 "$file"; log "Backup: $file"; }
nv_set() { key=$1; val=$2; if [ "$DRY_RUN" = "1" ]; then printf '[dry-run] nvram set %s=%s\n' "$key" "$val"; else nvram set "${key}=${val}"; fi; }
confirm_write() { [ "$ASSUME_YES" = "1" ] && return 0; printf 'About to modify %s. Continue? [y/N] ' "$1" >&2; read ans || true; case "$ans" in y|Y|yes|YES) ;; *) die "Cancelled." ;; esac; }

merlin_create() {
  c=$1; validate_client "$c"; merlin_preflight; select_profile; confirm_write "$c"; [ "$DRY_RUN" = "1" ] || backup_client "$c"
  nv_set "${c}_addr" "$WG_ADDRESS"; nv_set "${c}_alive" "$WG_KEEPALIVE"; nv_set "${c}_desc" "$(profile_desc)"; nv_set "${c}_dns" "$WG_DNS"; nv_set "${c}_enable" "$MERLIN_ENABLE"; nv_set "${c}_enforce" "$MERLIN_ENFORCE"; nv_set "${c}_ep_addr" "$endpoint"; nv_set "${c}_ep_addr_r" "$endpoint_ip"; nv_set "${c}_ep_port" "$WG_ENDPOINT_PORT"; nv_set "${c}_fw" "$MERLIN_FIREWALL"; nv_set "${c}_mtu" "$WG_MTU"; nv_set "${c}_nat" "$MERLIN_NAT"; nv_set "${c}_ppub" "$peer_key"; nv_set "${c}_priv" "$private_key"; nv_set "${c}_psk" "$MERLIN_PSK"; nv_set "${c}_tp" "$MERLIN_TP"; nv_set "${c}_tp_region" "$MERLIN_TP_REGION"; nv_set "${c}_aips" "$WG_ALLOWED_IPS"
  [ "$DRY_RUN" = "1" ] && { ok "Dry run complete; NVRAM was not changed."; return; }
  [ "$NVRAM_COMMIT" = "1" ] && nvram commit
  [ "$AUTO_APPLY" = "1" ] && service "restart_wgc ${c#wgc}"
  ok "$c configured for $hostname"
}

merlin_update() {
  c=$1; validate_client "$c"; merlin_preflight; select_profile; confirm_write "$c"; [ "$DRY_RUN" = "1" ] || backup_client "$c"
  nv_set "${c}_desc" "$(profile_desc)"; nv_set "${c}_ep_addr" "$endpoint"; nv_set "${c}_ep_addr_r" "$endpoint_ip"; nv_set "${c}_ep_port" "$WG_ENDPOINT_PORT"; nv_set "${c}_ppub" "$peer_key"
  [ "$DRY_RUN" = "1" ] && { ok "Dry run complete; NVRAM was not changed."; return; }
  [ "$NVRAM_COMMIT" = "1" ] && nvram commit
  [ "$AUTO_APPLY" = "1" ] && service "restart_wgc ${c#wgc}"
  ok "$c updated to $hostname"
}

prev=""
for arg in "$@"; do if [ "$prev" = "--config" ]; then CONFIG_FILE="$arg"; prev=""; continue; fi; [ "$arg" = "--config" ] && prev="--config"; done
load_config
[ "$#" -gt 0 ] || { usage; exit 0; }
cmd=$1; shift
subcmd=""; client=""
if [ "$cmd" = "merlin" ]; then [ "$#" -gt 0 ] || die "Missing merlin subcommand."; subcmd=$1; shift; case "$subcmd" in show|create|update) [ "$#" -gt 0 ] || die "Missing wgcN client."; client=$1; shift ;; esac; fi
while [ "$#" -gt 0 ]; do
  case "$1" in
    --country) COUNTRY=$2; shift 2 ;; --city) CITY=$2; shift 2 ;; --server) SERVER=$2; shift 2 ;; --group) GROUP=$2; shift 2 ;; --limit) LIMIT=$2; shift 2 ;; --config) CONFIG_FILE=$2; shift 2 ;; --token) ACCESS_TOKEN=$2; shift 2 ;; --token-file) TOKEN_FILE=$2; shift 2 ;; --desc) DESCRIPTION=$2; shift 2 ;; --dns) WG_DNS=$2; shift 2 ;; --keepalive) WG_KEEPALIVE=$2; shift 2 ;; --mtu) WG_MTU=$2; shift 2 ;; --endpoint) MERLIN_ENDPOINT_MODE=$2; shift 2 ;; --dry-run) DRY_RUN=1; shift ;; --yes|-y) ASSUME_YES=1; shift ;; -h|--help) usage; exit 0 ;; -v|--version) printf '%s %s\n' "$APP_NAME" "$VERSION"; exit 0 ;; *) die "Unknown option: $1" ;; esac
done

case "$cmd" in
  -h|--help|help) usage ;;
  -v|--version|version) printf '%s %s\n' "$APP_NAME" "$VERSION" ;;
  countries) list_countries ;;
  servers) print_servers ;;
  auth-test) auth_test ;;
  merlin) case "$subcmd" in list) merlin_list ;; show) merlin_show "$client" ;; create) merlin_create "$client" ;; update) merlin_update "$client" ;; *) die "Unknown merlin subcommand: $subcmd" ;; esac ;;
  *) die "Unknown command: $cmd" ;;
esac
