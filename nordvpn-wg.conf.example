# nordvpn-wg.conf - defaults for NordVPN WireGuard Manager
# Install as /opt/etc/nordvpn-wg.conf
#
# Precedence: built-in defaults < this file < CLI options.
# This file is sourced by /bin/sh. Keep it writable only by administrators.

# ---- Nord account ----------------------------------------------------------
# Recommended: put ONLY the token on the first line of this file and chmod 600.
TOKEN_FILE="/opt/etc/nordvpn-wg/token"
# ACCESS_TOKEN=""  # Supported, but storing the token directly here is less tidy.

# ---- Files/state -----------------------------------------------------------
STATE_DIR="/opt/var/lib/nordvpn-wg"
OUTPUT_DIR="/opt/var/lib/nordvpn-wg/profiles"

# ---- WireGuard defaults ----------------------------------------------------
WG_ADDRESS="10.5.0.2/32"
WG_DNS="192.168.50.1"
WG_ALLOWED_IPS="0.0.0.0/0,::/0"
WG_ENDPOINT_PORT="51820"
WG_KEEPALIVE="60"
WG_MTU=""                       # Blank = let Merlin/kernel choose.

# ---- Asuswrt-Merlin wgcN defaults -----------------------------------------
MERLIN_ENABLE="1"
MERLIN_ENFORCE="1"
MERLIN_FIREWALL="1"
MERLIN_NAT="1"
MERLIN_PSK=""
MERLIN_TP=""
MERLIN_TP_REGION=""

# "ip" stores the station IP in ep_addr. "hostname" stores the Nord hostname
# while ep_addr_r retains the station IP.
MERLIN_ENDPOINT_MODE="ip"

# ---- Safety/persistence ----------------------------------------------------
BACKUP_BEFORE_WRITE="1"         # Save existing wgcN_* variables before changes.
NVRAM_COMMIT="1"                # Persist writes across reboot; CLI --no-commit overrides.

# Applying is deliberately NOT configurable. create/update/restore/enable/disable
# never restart/start/stop a client unless --apply is supplied explicitly.
# Older configs may contain AUTO_APPLY=1; nordvpn-wg 0.2+ intentionally ignores it.
